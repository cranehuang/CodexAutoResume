[Unit]
Description=Codex auto resume web console (metrics + project whitelist)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/codex-auto-resume
ExecStart=/usr/bin/python3 %h/.local/share/codex-auto-resume/web.py --host 127.0.0.1 --port 8787
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
